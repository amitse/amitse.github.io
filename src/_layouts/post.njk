---
layout: base.njk
---
<article class="post-article" data-newsletter="{{ newsletter }}">

  <div class="post-channel-bar" style="--ch-accent: var(--ch-{{ newsletter | replace('-', '_') }}, var(--accent))"></div>

  <header class="post-header">
    <div class="post-header__eyeline">
      <a href="/{{ newsletter }}/" class="post-header__channel-link">{{ newsletter | newsletterLabel }}</a>
      <span class="post-header__sep">/</span>
      <span class="post-header__date">{{ page.date | readableDate }}</span>
      {% if edition %}<span class="post-header__sep">/</span><span class="post-header__edition">No. {{ edition }}</span>{% endif %}
    </div>
    <h1 class="post-header__title">{{ title }}</h1>
    {% if summary %}
    <p class="post-header__summary">{{ summary }}</p>
    {% endif %}
  </header>

  {% include "colophon.njk" %}

  <div class="post-body">
    {{ content | safe }}
  </div>

  {% if sources and sources.length %}
  <footer class="post-sources">
    <span class="post-sources__label">Sources</span>
    <div class="post-sources__list">
      {% for source in sources %}
      <span class="source-tag">{{ source }}</span>
      {% endfor %}
    </div>
  </footer>
  {% endif %}

  <nav class="post-nav">
    {% set prevPost = collections.allPosts | getPreviousCollectionItem(page) %}
    {% set nextPost = collections.allPosts | getNextCollectionItem(page) %}
    <div class="post-nav__cell">
      {% if prevPost %}
        <a href="{{ prevPost.url }}" class="post-nav__link post-nav__link--prev">
          <span class="post-nav__dir">← Earlier</span>
          <span class="post-nav__title">{{ prevPost.data.title }}</span>
        </a>
      {% endif %}
    </div>
    <div class="post-nav__cell post-nav__cell--right">
      {% if nextPost %}
        <a href="{{ nextPost.url }}" class="post-nav__link post-nav__link--next">
          <span class="post-nav__dir">Later →</span>
          <span class="post-nav__title">{{ nextPost.data.title }}</span>
        </a>
      {% endif %}
    </div>
  </nav>

</article>
