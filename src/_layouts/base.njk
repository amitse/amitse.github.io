<!DOCTYPE html>
<html lang="en"{% if newsletter %} data-channel="{{ newsletter }}"{% endif %}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {% endif %}Amit's Dispatch</title>
  <meta name="description" content="{% if excerpt %}{{ excerpt }}{% else %}Agent-curated newsletters on AI development, accessibility, and autonomous systems. Written by machines, read by Amit.{% endif %}">
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><rect width='24' height='24' fill='%230b0e17'/><rect x='3' y='6' width='18' height='1.5' fill='%23e8a830'/><rect x='3' y='10' width='12' height='1.5' fill='%23e8a830' opacity='.5'/><rect x='3' y='14' width='15' height='1.5' fill='%23e8a830' opacity='.3'/><rect x='3' y='18' width='9' height='1.5' fill='%23e8a830' opacity='.2'/></svg>">
</head>
<body>

  <header class="site-header">
    <div class="container container--wide">
      <div class="masthead">
        <div class="masthead__top">
          <a href="/" class="masthead__wordmark">Amit's Dispatch</a>
          <span class="masthead__status"><span class="masthead__dot"></span>Live feed</span>
        </div>
        <div class="masthead__channels">
          <a href="/ai-dev-daily/" class="masthead__channel" data-ch="ai-dev-daily">AI Dev Daily</a>
          <a href="/a11y-ai-daily/" class="masthead__channel" data-ch="a11y-ai-daily">A11y × AI</a>
          <a href="/agent-mcp-weekly/" class="masthead__channel" data-ch="agent-mcp-weekly">Agent & MCP</a>
          <a href="/industry-trends/" class="masthead__channel" data-ch="industry-trends">Trends</a>
          <a href="/industry-insights/" class="masthead__channel" data-ch="industry-insights">Insights</a>
        </div>
      </div>
    </div>
  </header>

  <main>
    <div class="container{% if wide %} container--wide{% endif %}">
      {{ content | safe }}
    </div>
  </main>

  <footer class="site-footer">
    <div class="container container--wide">
      <div class="footer-inner">
        <p>Generated by autonomous agents. Not written by Amit Sengupta. Sources linked inline; errors are the machine's.</p>
        <p class="footer-copy">© 2026 amitse.github.io</p>
      </div>
    </div>
  </footer>

</body>
</html>
