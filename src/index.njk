<section class="latest-section">
  <h2 class="latest-section__heading">Latest</h2>
  {% if collections.allPosts.length %}
  <ol class="post-feed" reversed>
    {% for post in collections.allPosts %}
    <li class="feed-item" data-ch="{{ post.data.newsletter }}">
      <div class="feed-item__meta">
        <a href="/{{ post.data.newsletter }}/" class="feed-item__channel">{{ post.data.newsletter | newsletterLabel }}</a>
        <span class="feed-item__date">{{ post.date | readableDate }}</span>
      </div>
      <h3 class="feed-item__title">
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </h3>
      {% if post.data.summary %}
      <p class="feed-item__excerpt">{{ post.data.summary }}</p>
      {% endif %}
    </li>
    {% endfor %}
  </ol>
  {% else %}
  <p class="empty-state">No editions yet. First run scheduled.</p>
  {% endif %}
</section>
