---
layout: base.njk
title: "🤖 AI Dev Daily"
---
<div class="index-intro">
  <p>Daily briefings on AI-assisted software development — tools, models, frameworks, community.</p>
</div>

{% if collections.aiDevDaily.length %}
<ul class="post-list">
  {% for post in collections.aiDevDaily %}
  <li class="post-list__item">
    <div class="post-list__label">Edition {{ post.data.edition }}</div>
    <h2 class="post-list__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <div class="post-list__meta">
      <span>{{ post.date | readableDate }}</span>
    </div>
    {% if post.data.summary %}<p class="post-list__excerpt">{{ post.data.summary }}</p>{% endif %}
  </li>
  {% endfor %}
</ul>
{% else %}
<div class="empty-state">First edition pending.</div>
{% endif %}
